{% extends 'layout.html.twig' %}

{% block body %}
    <div class="row d-flex p-4">
        <h2>Nos catégories disponibles</h2>
        {% for category in categories %}
            <div class="cat-summary col text-center m-2 p-2 border rounded bg-opacity-10 bg-light shadow align-middle d-flex align-items-center flex-column position-relative"
                 style="background-image: url('{{ asset('uploads/' ~ category.image) }}');">
                <strong class="bg-light bg-opacity-75 rounded p-2 mb-3 w-100">{{ category.label }}</strong>
                <p class="small mt-auto bg-primary bg-opacity-75 rounded p-1 text-white w-100"><strong>{{ category.nb }}</strong> produits</p>
                <a href="{{ path('app_category_articles', { id: category.id }) }}" class="text-decoration-none stretched-link"></a>
            </div>
        {% endfor %}
    </div>
    <div class="d-flex p-4 pb-0">
        <h2 class="">Nos derniers produits</h2>
    </div>
    <div class="d-flex p-4">
        <div class="flex-column">
            <div class="fb-page" data-href="https://www.facebook.com/duoimportmdg" data-tabs="timeline,messages" data-width="300" data-height="200" data-small-header="true" data-adapt-container-width="true" data-hide-cover="false" data-show-facepile="false">
            </div>
            <div class="fb-video" data-href="https://fb.watch/riFs1uFA3p/" data-width="300" data-show-text="true"><blockquote cite="https://www.facebook.com/duoimportmdg/videos/228561716977358/" class="fb-xfbml-parse-ignore"><a href="https://www.facebook.com/duoimportmdg/videos/228561716977358/"></a><p>✅Te hanafatra entana any Chine ve ianao?
                        ✅Mitady fournisseur?
                        ✅Manana fond fa tsy mahita idée de business ?
                        ✅Kelikely ny vola nefa tianao ahodina?
                        ✅Te hanao vente en ligne ?
                        ✅Mitady vadin&#039;asa ?

                        Araho ary ny vidéo! Dia aza misalasala mandefa hafatra mivantana na miantso ny laharana afahanao mahazo fanazavana fanampiny!

                        📞+261 38 42 711 68</p>Posted by <a href="https://www.facebook.com/duoimportmdg">Duo Import MDG</a> on Friday, January 26, 2024</blockquote></div>
        </div>
        <div class="d-flex flex-wrap ms-2 justify-content-evenly">
            {% for article in latestProducts %}
                <div class="mx-2" style="width: 200px;">
                    <div class="single_advisor_profile wow fadeInUp" data-wow-delay="0.2s">
                        <!-- Team Thumb-->
                        <div class="advisor_thumb" style="background-image: url('{{ asset('uploads/' ~ article.image) }}'); background-size: cover;">
                            <!-- Social Info-->
                            <div class="social-info"></div>
                        </div>
                        <!-- Team Details-->
                        <div class="single_advisor_details_info d-flex justify-content-end">
                            <div class="p-4 pb-0">
                                <h6>DUO#{{ article.id }}</h6>
                            </div>
                        </div>
                        <div class="bactions d-flex justify-content-between" style="margin-top: -11px; z-index: 0;">
                            <div class="p-4 position-relative">
                                <a href="{{ path('app_article_show', {'id': article.id}) }}" class="text-decoration-none stretched-link">
                                    <i class="fa fa-eye"></i>
                                </a>
                            </div>
                            <div class="p-4 position-relative">
                                <a href="javascript:void(0)" data-path="{{ path('app_wishlist_add', {id: article.id}) }}" class="text-decoration-none stretched-link addToCart">
                                    <i class="fa-solid fa-cart-plus"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}